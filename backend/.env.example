# ===========================================
# CONFIGURATION BACKEND - MWANGAZA WETU
# ===========================================

# ---------------------------------------------
# DATABASE (PostgreSQL via Prisma)
# ---------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:password@localhost:5432/mwangaza_wetu?schema=public"
# Connexion PostgreSQL directe réservée aux migrations Prisma (si DATABASE_URL utilise un pooler)
DIRECT_URL="postgresql://postgres:password@localhost:5432/mwangaza_wetu?schema=public"

# ---------------------------------------------
# CLOUDINARY (stockage des photos)
# ---------------------------------------------
CLOUDINARY_CLOUD_NAME="votre-cloud-name"
CLOUDINARY_API_KEY="votre-api-key"
CLOUDINARY_API_SECRET="votre-api-secret"

# ---------------------------------------------
# JWT AUTHENTICATION
# ---------------------------------------------
# Clé secrète pour signer les tokens JWT (utiliser une valeur forte en production)
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="votre-cle-secrete-tres-longue-et-aleatoire-ici"

# ---------------------------------------------
# SERVER CONFIGURATION
# ---------------------------------------------
# Port du serveur backend (par défaut: 4000)
# ⚠️ Éviter le port 6000 : bloqué par les navigateurs (ERR_UNSAFE_PORT)
PORT=4000

# URL du frontend pour CORS (Next.js)
FRONTEND_URL="http://localhost:5000"

# ---------------------------------------------
# EMAIL SMTP (envoi des identifiants temporaires des membres)
# ---------------------------------------------
MAIL_HOST="smtp.example.com"
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM="Mwangaza Wetu <no-reply@example.com>"
# URL de connexion du portail membre (facultatif; défaut: FRONTEND_URL/login)
MEMBER_LOGIN_URL="http://localhost:5000/login"

# ---------------------------------------------
# NODE ENVIRONMENT
# ---------------------------------------------
NODE_ENV="development"
# Options: development | production | test

# ---------------------------------------------
# BIOMETRIE ZKTeco (terminal de pointage/empreinte)
# ---------------------------------------------
# Adresse IP et port UDP/TCP du terminal (menu réseau de l'appareil)
ZKTECO_IP="10.25.114.235"
ZKTECO_PORT=4370
# Timeout socket (ms) — échec si l'appareil est éteint/injoignable
ZKTECO_TIMEOUT=10000
# Port local d'écoute pour les logs temps réel
ZKTECO_INPORT=4000
# Timeout de capture d'empreinte (ms) — 30000 = 30 s avant erreur 500
ZKTECO_CAPTURE_TIMEOUT=30000
# ⚠️ node-zklib ne supporte PAS le mot de passe de communication :
# l'appareil doit rester sans mot de passe comm (ou le désactiver).
