# Modèle de configuration pour lancer les tests e2e en local.
#
# 1. Copier ce fichier en `.env.test.local` (gitignoré).
# 2. Créer une base PostgreSQL locale, par exemple :
#      createdb mwangaza_test
# 3. Appliquer le schéma :
#      npm run prisma:deploy   # ou npx prisma migrate deploy
# 4. Lancer :
#      npm run test:e2e
#
# Le script refuse toute DATABASE_URL non locale : il n'écrit jamais dans la
# base distante, même si `.env` pointe vers Render/Neon.

NODE_ENV=test
DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/mwangaza_test

# Secret de test uniquement (32 caractères minimum). Ne jamais réutiliser.
JWT_SECRET=replace-with-a-32-character-test-secret

# Redis est optionnel en test : le module bascule sur un cache mémoire.
# REDIS_URL=redis://localhost:6379

FRONTEND_URL=http://localhost:5000
PORT=4001
